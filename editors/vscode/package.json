{
  "name": "forge-yaml",
  "displayName": "Forge YAML",
  "description": "Highlights the formulas in Forge model files and checks the files against the Forge schema",
  "version": "4.1.0",
  "publisher": "mollendorff-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/mollendorff-ai/forge"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "yaml",
    "forge",
    "formula",
    "financial model"
  ],
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "forge.formula.injection",
        "path": "./syntaxes/forge-formula.injection.json",
        "injectTo": [
          "source.yaml"
        ]
      },
      {
        "scopeName": "forge.formula.single.injection",
        "path": "./syntaxes/forge-formula-single.injection.json",
        "injectTo": [
          "source.yaml"
        ]
      },
      {
        "scopeName": "forge.formula.plain.injection",
        "path": "./syntaxes/forge-formula-plain.injection.json",
        "injectTo": [
          "source.yaml"
        ]
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "*.forge.yaml",
          "*.forge.yml"
        ],
        "url": "./schemas/forge.schema.json"
      }
    ]
  },
  "scripts": {
    "test": "node test/grammar.js && node test/schema.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "yaml-language-server": "2.0.0"
  }
}
