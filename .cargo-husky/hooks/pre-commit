#!/bin/bash
#
# Forge pre-commit hook - mirrors CI checks
# Must be as strict as .github/workflows/ci.yml
# Auto-installed by cargo-husky on `cargo test`

set -e

echo "🔍 Running pre-commit checks..."

echo "📐 Checking formatting..."
cargo fmt --all -- --check

echo "📎 Running clippy (pedantic)..."
make lint

echo "🧪 Running tests..."
cargo test --all-features

echo "📄 Checking the repository against the binary (validation/repo)..."
cargo build --bin forge
cargo test -p mollendorff-forge-repo

# Möllendorff AI Asimov checks (if installed and commands available)
if command -v asimov &> /dev/null; then
    asimov validate 2>/dev/null || true
fi

echo "✅ Pre-commit checks passed!"
